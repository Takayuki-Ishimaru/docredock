<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DocRedock.Core\DocRedock.Core.csproj" />
    <ProjectReference Include="..\DocRedock.Providers.Abstractions\DocRedock.Providers.Abstractions.csproj" />
    <ProjectReference Include="..\DocRedock.Markdown\DocRedock.Markdown.csproj" />
    <ProjectReference Include="..\DocRedock.RoundTrip\DocRedock.RoundTrip.csproj" />
    <ProjectReference Include="..\DocRedock.Api\DocRedock.Api.csproj" />
    <ProjectReference Include="..\DocRedock.VisualInference\DocRedock.VisualInference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\licenses\allowlist.json" LogicalName="DocRedock.LicenseAllowlist.json" />
    <EmbeddedResource Include="..\..\docs\DRMD_AI_EDITING_RULES.md"
                      LogicalName="DocRedock.DRMD_AI_EDITING_RULES.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DocRedock.Cli</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>DocRedock</AssemblyTitle>
    <Product>DocRedock</Product>
    <Description>DocRedock command-line document round-tripping tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- A conversion holds a large document in memory and then several projections of it in turn: the garbage
         collector compacts the heap rather than let it grow (a 50,000-row workbook peaks at about 400 MB instead of
         500 MB, and its AI package at about 520 MB instead of 740 MB, for a few percent of time). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

</Project>
