<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rtmd.Api\Rtmd.Api.csproj" />
    <ProjectReference Include="..\Rtmd.Core\Rtmd.Core.csproj" />
    <ProjectReference Include="..\Rtmd.Ocr.Tesseract\Rtmd.Ocr.Tesseract.csproj" />
    <ProjectReference Include="..\Rtmd.RoundTrip\Rtmd.RoundTrip.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>RoundHound</AssemblyName>
    <AssemblyTitle>RoundHound</AssemblyTitle>
    <Product>RoundHound</Product>
    <Description>A local-first document to Markdown round-trip workspace.</Description>
    <ApplicationIcon>Assets/RoundHound.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
