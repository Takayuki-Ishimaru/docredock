<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Rtmd.Gui.MainWindow"
        Title="RoundHound — Local Document Bridge"
        Icon="/Assets/RoundHound.ico"
        Width="1180"
        MinWidth="760"
        Height="820"
        MinHeight="620">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28" MaxWidth="1180" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="28">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Classes="brand-mark" Width="48" Height="48" CornerRadius="16" Padding="6">
          <Image Source="/Assets/RoundHound-appicon-64x64.png" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="RoundHound" FontSize="20" FontWeight="Bold" LetterSpacing="1.4" />
          <TextBlock Text="LOCAL DOCUMENT BRIDGE" Classes="muted overline" />
        </StackPanel>
        <Border Grid.Column="2" Classes="platform-badge" Padding="10,5" CornerRadius="12" VerticalAlignment="Center">
          <TextBlock Text="LOCAL · PRIVATE" Classes="muted overline" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="720" Spacing="12">
        <TextBlock Text="ROUND-TRIP WORKSPACE" Classes="primary overline" HorizontalAlignment="Center" />
        <Border Classes="accent-line" Width="54" Height="4" CornerRadius="2" HorizontalAlignment="Center" />
        <TextBlock Text="文書を、迷わず&#x0a;Markdownへ。" FontSize="36" FontWeight="SemiBold" LineHeight="46" TextAlignment="Center" />
        <TextBlock Text="RoundHoundは、OfficeやPDFを読みやすいMarkdownまたは復元可能なRTMDへ変換します。処理はすべてこのコンピューター内で完結します。"
                   Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
        <Border Classes="local-badge" HorizontalAlignment="Center" Padding="10,5" CornerRadius="14">
          <TextBlock Text="⌁  ファイルはこのコンピューターから出ません" Classes="primary" FontSize="12" />
        </Border>
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24" VerticalAlignment="Top">
        <Border Classes="card export-card" Padding="28" CornerRadius="14">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
              <Border Classes="primary step-number" Width="42" Height="42" CornerRadius="21">
                <TextBlock Text="01" Classes="on-dark" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="DOCUMENT → RTMD" Classes="muted overline" />
                <TextBlock Text="Markdownへ書き出す" FontSize="23" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="読むためのMarkdownか、元形式へ戻せるRTMDを選んで書き出します。" Classes="muted" TextWrapping="Wrap" />

            <Button Grid.Row="2" x:Name="ExportDropZone" Classes="drop-zone primary" Padding="24" MinHeight="165"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnPickExportFile"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="OnExportDragOver" DragDrop.DragLeave="OnExportDragLeave" DragDrop.Drop="OnExportDrop"
                    AutomationProperties.Name="変換する文書を選択">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <TextBlock Text="⇧" Classes="primary" FontSize="35" HorizontalAlignment="Center" />
                <TextBlock Text="ここにドロップ" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="またはクリックして選択" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="DOCX · XLSX · PPTX · PDF（最大 200 MB）" Classes="muted overline" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <StackPanel Grid.Row="3" Spacing="7">
              <Border Classes="file-selection" Padding="12" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Border Classes="primary file-type" Width="38" Height="38" CornerRadius="4">
                    <TextBlock x:Name="ExportFileTypeText" Text="—" Classes="on-dark" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ExportFileNameText" Text="ファイル未選択" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ExportFileDetailText" Text="DOCX · XLSX · PPTX · PDF" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="flat" Click="OnClearExportFile" ToolTip.Tip="選択を解除">×</Button>
                </Grid>
              </Border>
              <Button Classes="flat" HorizontalAlignment="Left" Click="OnPickExportSourceFolder"
                      ToolTip.Tip="選択したフォルダー直下の対応文書をまとめて追加します">フォルダー内の文書を一括選択</Button>
            </StackPanel>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="読みやすいMarkdown" FontWeight="SemiBold" />
                <TextBlock Text="見出し・段落・表に再構成し、.mdだけを書き出します。元形式への復元には使いません。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="ReadableExportToggle" Grid.Column="1" Content="有効" IsChecked="True" VerticalAlignment="Center" IsCheckedChanged="OnReadableChanged" />
            </Grid>

            <StackPanel x:Name="ReadableOptionsPanel" Grid.Row="5" Spacing="6">
              <TextBlock Text="読みやすいMarkdownの内容" Classes="muted" FontSize="11" />
              <WrapPanel>
                <CheckBox x:Name="IncludeDiagramsCheckBox" Content="図を含める" IsChecked="True" Margin="0,0,14,6" IsCheckedChanged="OnSettingsChanged" />
                <CheckBox x:Name="ShowFormulasCheckBox" Content="数式も表示" Margin="0,0,14,6" IsCheckedChanged="OnSettingsChanged" />
                <CheckBox x:Name="IncludeSvgCheckBox" Content="SVGプレビューを埋め込む" Margin="0,0,14,6" IsCheckedChanged="OnSettingsChanged" />
                <CheckBox x:Name="EmbedReadableImagesCheckBox" Content="画像をMarkdownへ埋め込む" ToolTip.Tip="既定では.assetsフォルダーを参照します。明示すると画像をdata URL化し、Markdown単体で完結させます。" Margin="0,0,14,6" IsCheckedChanged="OnSettingsChanged" />
              </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="画像の文字をOCR" FontWeight="SemiBold" />
                <TextBlock Text="Tesseract、またはmacOSのApple Visionで画像の文字を読み取ります。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="OcrToggle" Grid.Column="1" Content="有効" IsChecked="False" VerticalAlignment="Center" IsCheckedChanged="OnOcrChanged" />
            </Grid>

            <Grid x:Name="OcrLanguagesPanel" Grid.Row="7" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="False">
              <TextBlock Text="OCR言語" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="OcrLanguagesTextBox" Grid.Column="1" Text="jpn+eng" IsEnabled="False" PlaceholderText="例: jpn+eng" MaxLength="80" />
            </Grid>

            <StackPanel Grid.Row="8" Spacing="8">
              <TextBlock x:Name="ExportErrorText" Classes="error" IsVisible="False" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="ExportFolderButton" Classes="secondary" Click="OnPickExportFolder">出力フォルダーを選択</Button>
                <Button x:Name="ExportButton" Grid.Column="1" Classes="accent" Click="OnExport" IsEnabled="False">書き出す</Button>
              </Grid>
              <TextBlock x:Name="ExportFolderText" Text="出力先: 元ファイルと同じフォルダー" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card restore-card" Padding="28" CornerRadius="14">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
              <Border Classes="secondary step-number" Width="42" Height="42" CornerRadius="21">
                <TextBlock Text="02" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="RTMD → DOCUMENT" Classes="muted overline" />
                <TextBlock Text="元の形式へ復元する" FontSize="23" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="編集済みMarkdownと書き出し時のRTMDパッケージを一緒に指定します。" Classes="muted" TextWrapping="Wrap" />

            <Button Grid.Row="2" x:Name="RestoreDropZone" Classes="drop-zone secondary" Padding="24" MinHeight="165"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnPickRestoreFiles"
                    DragDrop.AllowDrop="True" DragDrop.DragOver="OnRestoreDragOver" DragDrop.DragLeave="OnRestoreDragLeave" DragDrop.Drop="OnRestoreDrop"
                    AutomationProperties.Name="復元するMarkdownとRTMDパッケージを選択">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <TextBlock Text="⇧" Classes="secondary" FontSize="35" HorizontalAlignment="Center" />
                <TextBlock Text="2ファイルをドロップ" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="同時でも、1つずつでもOK" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="EDITED .MD + .RTMDPKG" Classes="muted overline" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8">
              <Border Classes="file-selection" Padding="10" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                  <Border Classes="secondary file-type" Width="34" Height="34" CornerRadius="4"><TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"><TextBlock x:Name="MarkdownFileNameText" Text="編集済みMarkdown" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MarkdownFileDetailText" Text="未選択" Classes="muted" FontSize="10" /></StackPanel>
                  <TextBlock x:Name="MarkdownStatusText" Grid.Column="2" Text="○" Classes="muted" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Row="1" Classes="file-selection" Padding="10" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                  <Border Classes="secondary file-type" Width="34" Height="34" CornerRadius="4"><TextBlock Text="PKG" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" FontWeight="Bold" /></Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"><TextBlock x:Name="PackageFileNameText" Text="RTMDパッケージ" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="PackageFileDetailText" Text="未選択" Classes="muted" FontSize="10" /></StackPanel>
                  <TextBlock x:Name="PackageStatusText" Grid.Column="2" Text="○" Classes="muted" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="編集済みPDFを再描画" FontWeight="SemiBold" />
                <TextBlock Text="元PDFと同一レイアウトではないF3出力を許可します。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch x:Name="PdfFallbackToggle" Grid.Column="1" Content="許可" VerticalAlignment="Center" IsCheckedChanged="OnSettingsChanged" />
            </Grid>

            <Border Grid.Row="5" Classes="notice" Padding="10" CornerRadius="6">
              <TextBlock Text="復元先に同名ファイルがある場合は上書きせず、安全に停止します。" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="6" Spacing="8">
              <TextBlock x:Name="RestoreErrorText" Classes="error" IsVisible="False" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button x:Name="RestoreFolderButton" Classes="secondary" Click="OnPickRestoreFolder">出力フォルダーを選択</Button>
                <Button x:Name="RestoreButton" Grid.Column="1" Classes="secondary" Click="OnRestore" IsEnabled="False">復元する</Button>
              </Grid>
              <TextBlock x:Name="RestoreFolderText" Text="出力先: Markdownと同じフォルダー" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" x:Name="ResultPanel" Classes="result-panel" Padding="22" CornerRadius="14" IsVisible="False">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <Border x:Name="ResultSymbol" Classes="primary result-symbol" Width="48" Height="48" CornerRadius="24">
            <TextBlock x:Name="ResultSymbolText" Text="✓" Classes="on-dark" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="7">
            <TextBlock x:Name="ResultKickerText" Text="COMPLETE" Classes="primary overline" />
            <TextBlock x:Name="ResultTitleText" Text="処理が完了しました" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ResultMessageText" Classes="muted" TextWrapping="Wrap" />
            <ProgressBar x:Name="OperationProgressBar" Classes="accent" IsIndeterminate="True" IsVisible="False" />
            <TextBlock x:Name="ResultFidelityText" Classes="fidelity" IsVisible="False" />
            <TextBox x:Name="DiagnosticsTextBox" Classes="diagnostics" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" IsVisible="False" MinHeight="72" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="OpenOutputFolderButton" Classes="secondary" HorizontalAlignment="Left" Click="OnOpenOutputFolder" IsVisible="False">出力フォルダーを開く</Button>
              <Button x:Name="OpenMarkdownButton" Classes="secondary" HorizontalAlignment="Left" Click="OnOpenMarkdown" IsVisible="False">Markdownを開く</Button>
              <Button x:Name="CancelOperationButton" Classes="flat" HorizontalAlignment="Left" Click="OnCancelOperation" IsVisible="False">キャンセル</Button>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Classes="flat" Click="OnCloseResult" ToolTip.Tip="結果を閉じる">×</Button>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
