<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    RoundHound Dawn theme

    The palette is intentionally kept to the five canonical Dawn colors.
    Orange is reserved for calls to action and attention states; blue carries
    the everyday interactive state.
  -->
  <Styles.Resources>
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="#FF6B1A" />
    <SolidColorBrush x:Key="BrandLavenderBrush" Color="#C6A7E8" />
    <SolidColorBrush x:Key="BrandBlueBrush" Color="#4057D6" />
    <SolidColorBrush x:Key="BrandBlackBrush" Color="#191827" />
    <SolidColorBrush x:Key="BrandMistBrush" Color="#F2EEF5" />

    <SolidColorBrush x:Key="ColorPrimaryBrush" Color="#4057D6" />
    <SolidColorBrush x:Key="ColorAccentBrush" Color="#FF6B1A" />
    <SolidColorBrush x:Key="ColorSecondaryBrush" Color="#C6A7E8" />
    <SolidColorBrush x:Key="ColorForegroundBrush" Color="#191827" />
    <SolidColorBrush x:Key="ColorBackgroundBrush" Color="#F2EEF5" />

    <!-- Fluent controls consume these keys for selected/toggled states. -->
    <Color x:Key="SystemAccentColor">#4057D6</Color>
    <Color x:Key="SystemAccentColorLight1">#4057D6</Color>
    <Color x:Key="SystemAccentColorDark1">#4057D6</Color>

    <CornerRadius x:Key="DawnControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="DawnCardCornerRadius">12</CornerRadius>
  </Styles.Resources>

  <!-- Application-wide light surface and readable default text. -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="FontFamily" Value="Noto Sans JP, Noto Sans, Segoe UI, sans-serif" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="TextBlock.on-dark">
    <Setter Property="Foreground" Value="{StaticResource BrandMistBrush}" />
  </Style>

  <Style Selector="TextBlock.on-accent">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.fidelity">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.brand-mark">
    <Setter Property="Background" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.platform-badge">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.primary">
    <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="Border.secondary">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="Border.local-badge">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.accent-line">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
  </Style>

  <Style Selector="Border.file-selection">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="Border.result-panel">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.result-panel.error">
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
  </Style>

  <Style Selector="Border.result-symbol.error">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
  </Style>

  <!-- Reusable surfaces: Border, Panel, and other ContentControls can use
       these classes without depending on a particular MainWindow layout. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnCardCornerRadius}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnCardCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.section">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,12" />
  </Style>

  <Style Selector="ContentControl.card">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnCardCornerRadius}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Buttons: blue is the normal action; orange is deliberately opt-in. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandMistBrush}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
  </Style>

  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="Button.flat:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="Button.accent:disabled">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <!-- Text input and selection controls. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="TextBox.diagnostics">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
    <Setter Property="MinHeight" Value="38" />
  </Style>

  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandMistBrush}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="CheckBox:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
  </Style>

  <Style Selector="CheckBox:checked">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="CheckBox:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Progress and operation state. -->
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="MinHeight" Value="10" />
  </Style>

  <Style Selector="ProgressBar.accent">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.status-success">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.status-info">
    <Setter Property="Foreground" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="TextBlock.status-warning">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.status-error">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Border.status">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.status-warning">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnControlCornerRadius}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- File selection / drag-and-drop target. -->
  <Style Selector="Border.drop-zone">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnCardCornerRadius}" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="MinHeight" Value="124" />
  </Style>

  <Style Selector="Border.drop-zone:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="Border.drop-zone.drag-over">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="Button.drop-zone">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource DawnCardCornerRadius}" />
    <Setter Property="Padding" Value="28" />
    <Setter Property="MinHeight" Value="124" />
  </Style>

  <Style Selector="Button.drop-zone:pointerover">
    <Setter Property="Background" Value="{StaticResource BrandMistBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBrush}" />
  </Style>

  <Style Selector="Button.drop-zone:pressed">
    <Setter Property="Background" Value="{StaticResource BrandLavenderBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}" />
  </Style>

  <Style Selector="Button.drop-zone.drag-over">
    <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrandBlackBrush}" />
  </Style>

  <Style Selector="TextBlock.drop-zone-title">
    <Setter Property="Foreground" Value="{StaticResource BrandBlackBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</Styles>
