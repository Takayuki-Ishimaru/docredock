<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocRedock.Gui.ReviewWindow"
        Title="原本照合 — DocRedock"
        Icon="/Assets/DocRedock.ico"
        Width="1180"
        Height="780"
        MinWidth="720"
        MinHeight="480">
  <DockPanel LastChildFill="True">
    <!-- What to check on the selected page, in the same short words as the result panel. -->
    <Border DockPanel.Dock="Top" Classes="titlebar" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="6">
        <ComboBox x:Name="PageSelector" MinWidth="260" VerticalAlignment="Center" SelectionChanged="OnPageChanged"
                  AutomationProperties.Name="確認するページ" />
        <TextBlock x:Name="PageDescriptionText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                   FontWeight="SemiBold" AutomationProperties.Name="確認する内容" />
        <TextBlock x:Name="LegendText" Grid.Row="1" Grid.ColumnSpan="2" Classes="muted caption" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="actionbar">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,0" VerticalAlignment="Center">
        <Button x:Name="OpenImageButton" Classes="secondary compact" Click="OnOpenImage"
                AutomationProperties.Name="照合画像を別のアプリで開く">画像を別のアプリで開く</Button>
        <Button x:Name="OpenMarkdownButton" Classes="secondary compact" Click="OnOpenMarkdown"
                AutomationProperties.Name="Markdown全体を開く">Markdown全体を開く</Button>
        <Button Classes="accent compact" Click="OnClose" AutomationProperties.Name="閉じる">閉じる</Button>
      </StackPanel>
    </Border>

    <!-- Source page image (with the unresolved elements framed) beside the Markdown of that page. -->
    <Grid x:Name="ReviewColumns" ColumnDefinitions="3*,2*" ColumnSpacing="14" Margin="20,14,20,14">
      <Border Classes="workspace-card" Padding="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="原本のページ画像" Classes="section-label" VerticalAlignment="Center" />
            <!-- A small path is hard to make out on the whole page: zoom straight to each
                 element to check, or step the zoom by hand (Ctrl + mouse wheel also zooms). -->
            <StackPanel x:Name="ZoomBar" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="FocusText" Classes="muted caption" VerticalAlignment="Center" Margin="0,0,4,0" />
              <!-- Once an element is found, the red marks can be hidden to see the original under them. -->
              <CheckBox x:Name="HighlightCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"
                        IsCheckedChanged="OnHighlightToggled"
                        AutomationProperties.Name="要確認箇所の強調表示">強調表示</CheckBox>
              <Button x:Name="ZoomToElementButton" Classes="secondary compact" Click="OnZoomToElement"
                      AutomationProperties.Name="要確認箇所へ拡大">要確認箇所へ拡大</Button>
              <Button x:Name="ZoomOutButton" Classes="secondary compact" Click="OnZoomOut" MinWidth="34"
                      AutomationProperties.Name="縮小">－</Button>
              <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center"
                         AutomationProperties.Name="表示倍率" />
              <Button x:Name="ZoomInButton" Classes="secondary compact" Click="OnZoomIn" MinWidth="34"
                      AutomationProperties.Name="拡大">＋</Button>
              <Button x:Name="FitButton" Classes="secondary compact" Click="OnFit"
                      AutomationProperties.Name="ページ全体を表示">全体</Button>
            </StackPanel>
          </Grid>
          <Panel Grid.Row="1">
            <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          IsVisible="False">
              <LayoutTransformControl x:Name="ImageZoom" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Panel x:Name="ImageSurface">
                  <Image x:Name="PageImage" Stretch="Fill" AutomationProperties.Name="原本照合用のページ画像" />
                  <Canvas x:Name="HighlightCanvas" />
                </Panel>
              </LayoutTransformControl>
            </ScrollViewer>
            <TextBlock x:Name="NoImageText" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" MaxWidth="420" IsVisible="False" />
          </Panel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="workspace-card" Padding="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="このページのMarkdown" Classes="section-label" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="segment-track">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton x:Name="MarkdownRenderedRadio" Classes="segment" GroupName="ReviewMarkdownView" IsChecked="True"
                             IsCheckedChanged="OnMarkdownViewChanged" AutomationProperties.Name="Markdownを表示形式で見る">表示</RadioButton>
                <RadioButton x:Name="MarkdownSourceRadio" Classes="segment" GroupName="ReviewMarkdownView"
                             IsCheckedChanged="OnMarkdownViewChanged" AutomationProperties.Name="Markdownのソースを見る">ソース</RadioButton>
              </StackPanel>
            </Border>
          </Grid>
          <Panel Grid.Row="1">
            <ScrollViewer x:Name="MarkdownPreviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="このページのMarkdown（表示）">
              <ContentControl x:Name="MarkdownPreviewHost" />
            </ScrollViewer>
            <TextBox x:Name="PageMarkdownTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Menlo, Consolas, monospace" FontSize="12" IsVisible="False"
                     AutomationProperties.Name="このページのMarkdown" />
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
