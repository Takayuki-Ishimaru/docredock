{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docredock.local/schemas/report.schema.json",
  "title": "DRMD operation report 1.0",
  "type": "object",
  "required": ["schema_version", "operation", "success", "fidelity_level", "warnings", "diagnostics"],
  "properties": {
    "schema_version": { "type": "string" },
    "operation": { "type": "string" },
    "success": { "type": "boolean" },
    "fidelity_level": { "enum": ["F0", "F1", "F2", "F3", "FX"] },
    "package_preservation_level": { "type": ["string", "null"] },
    "warnings": { "type": "array" },
    "diagnostics": { "type": "array" }
  }
}
